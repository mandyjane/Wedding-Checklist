      "id": "legal",
      "title": "Legal & Admin",
      "items": [
        {
          "id": "legal-1",
          "text": "Lodge Notice of Intended Marriage (NOIM) — must be lodged 1–18 months before"
        },
        {
          "id": "legal-2",
          "text": "Confirm NOIM is lodged and accepted"
        },
        {
          "id": "legal-3",
          "text": "Obtain birth certificates or proof of identity for both parties"
        },
        {
          "id": "legal-5",
          "text": "Arrange witnesses (minimum 2 adults) for signing on the day"
        },
        {
          "id": "legal-6",
          "text": "Confirm celebrant has your legal paperwork sorted"
        },
        {
          "id": "legal-8",
          "text": "Name change checklist ready (licence, passport, bank, Medicare, super, employer, ATO)"
        }
      ]
    },
